// Koperasi Simpan Pinjam TNI AD — Lomba RTI 2026
// PostgreSQL (NeonDB)

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. DATA MASTER KODIFIKASI TNI AD (wajib panitia)
// tb_kotama, tb_satker (Satminkal), tb_pkt, tb_crp
// ==========================================

model Kotama {
  id               String             @id @default(uuid())
  kode             String             @unique // kd_Kotama
  nama             String // nm_Kotama
  tipe             String             @default("KOTAMA") // KOTAMA atau BALAKPUS
  status           Boolean            @default(true)
  satminkal        Satminkal[]
  users            User[]
  kopstuk          Kopstuk[]
  tajukTandaTangan TajukTandaTangan[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("tb_kotama")
}

model Satminkal {
  id        String    @id @default(uuid())
  kode      String    @unique // kd_Satker
  nama      String // nm_Satker
  status    Boolean   @default(true)
  kotamaId  String
  kotama    Kotama    @relation(fields: [kotamaId], references: [id])
  users     User[]
  anggota   Anggota[]
  kopstuk   Kopstuk?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pendapatan           Pendapatan[]
  biayaOperasional     BiayaOperasional[]
  tajukTandaTangan     TajukTandaTangan[]
  pengaturanKoperasi   PengaturanKoperasi?
  kategoriProduk       KategoriProduk[]
  produk               Produk[]
  supplier             Supplier[]
  pembelianSupplier    PembelianSupplier[]
  returSupplier        ReturSupplier[]
  transaksiPos         TransaksiPos[]
  pesananOnline        PesananOnline[]
  pengajuanMarketplace PengajuanMarketplace[]
  gadaiBarang          GadaiBarang[]
  eventUndian          EventUndian[]
  targetBelanjaBulanan TargetBelanjaBulanan[]

  @@index([kotamaId])
  @@map("tb_satker")
}

model Pangkat {
  id       String          @id @default(uuid())
  kodePkt  Int             @unique // kd_pkt
  nama     String // ur_pkt
  kategori KategoriPangkat
  anggota  Anggota[]

  @@map("tb_pkt")
}

model Korps {
  id      String    @id @default(uuid())
  kode    String    @unique @db.Char(1) // kd_crp
  nama    String // ur_crp
  anggota Anggota[]

  @@map("tb_crp")
}

enum KategoriPangkat {
  PATI
  PAMEN
  PAMA
  BINTARA
  BATA_ASN
  PNS
}

// ==========================================
// 2. MANAGEMENT USER & AUTHENTICATION
// ==========================================

enum Role {
  SUPER_ADMIN
  ADMIN_KOTAMA
  ADMIN_SATMINKAL
  ADMIN_KOPERASI
  PIMPINAN
  KEPRIM
  BENDAHARA
  PENGAWAS
  ANGGOTA
  JURU_BAYAR
  KASIR_TOKO
  PETUGAS_GADAI
}

model User {
  id                  String         @id @default(uuid())
  username            String         @unique
  password            String
  namaLengkap         String
  role                Role           @default(ADMIN_KOPERASI)
  kotamaId            String?
  kotama              Kotama?        @relation(fields: [kotamaId], references: [id])
  satminkalId         String?
  satminkal           Satminkal?     @relation(fields: [satminkalId], references: [id])
  isActive            Boolean        @default(true)
  currentSessionToken String?
  lastActiveAt        DateTime?
  passwordHistories   PasswordHistory[]
  transaksiPos        TransaksiPos[] @relation("KasirTransaksi")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([kotamaId])
  @@index([satminkalId])
  @@map("User")
}

model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("tb_password_history")
}

// ==========================================
// 3. ENTITAS ANGGOTA KOPERASI
// ==========================================

enum TipeAnggota {
  ORGANIK
  NON_ORGANIK
}

model Anggota {
  id            String                 @id @default(uuid())
  nama          String
  nrpNip        String                 @unique
  pangkatId     String
  pangkat       Pangkat                @relation(fields: [pangkatId], references: [id])
  korpsId       String
  korps         Korps                  @relation(fields: [korpsId], references: [id])
  satminkalId   String
  satminkal     Satminkal              @relation(fields: [satminkalId], references: [id])
  tipeAnggota   TipeAnggota            @default(ORGANIK)
  creditLimit   Decimal                @default(5000000) @db.Decimal(18, 2)
  isAktif       Boolean                @default(true)
  tmtAnggota    DateTime               @default(now())
  simpanan      Simpanan[]
  pinjaman      Pinjaman[]
  shuAnggota    ShuAnggota[]
  transaksiPos  TransaksiPos[]
  pesananOnline PesananOnline[]
  marketplace   PengajuanMarketplace[]
  gadaiBarang   GadaiBarang[]
  poinAnggota   PoinAnggota?
  kuponUndian   KuponUndian[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([satminkalId])
}

// ==========================================
// 4. SIMPANAN
// ==========================================

enum JenisSimpanan {
  POKOK // Rp 50.000 (sekali / dinamis)
  WAJIB // Rp 100.000 (sekali/rutin / dinamis)
  SUKARELA // Tabungan bebas per bulan
  KHUSUS // Simpanan Khusus (Qurban/Hari Raya/kegiatan khusus)
}

enum JenisTransaksiSimpanan {
  SETOR
  TARIK
}

model Simpanan {
  id         String                 @id @default(uuid())
  anggotaId  String
  anggota    Anggota                @relation(fields: [anggotaId], references: [id])
  jenis      JenisSimpanan
  tipe       JenisTransaksiSimpanan @default(SETOR) // <-- DITAMBAHKAN
  nominal    Decimal                @db.Decimal(18, 2)
  periode    DateTime? // bulan simpanan (misal: tanggal 5)
  noInvoice  String? // <-- DITAMBAHKAN untuk kwitansi
  keterangan String?
  createdAt  DateTime               @default(now())

  @@index([anggotaId, jenis])
  @@index([periode])
}

// ==========================================
// 5. PINJAMAN & ANGSURAN
// ==========================================

enum TipePinjaman {
  UANG_USIPA
  BARANG_TOKO
  DANA_GADAI
}

enum StatusPinjaman {
  DIAJUKAN
  VERIFIKASI_PRIMKOP
  VERIFIKASI_JURU_BAYAR
  REKOMENDASI_PIMPINAN
  SETUJU_KEPRIM
  DITOLAK
  MENUNGGU_DOKUMEN
  DICAIRKAN
  LUNAS
}

model Pinjaman {
  id               String            @id @default(uuid())
  anggotaId        String
  anggota          Anggota           @relation(fields: [anggotaId], references: [id])
  tipePinjaman     TipePinjaman      @default(UANG_USIPA)
  nominal          Decimal           @db.Decimal(18, 2)
  tenorBulan       Int
  bungaPersenTahun Decimal           @default(12) @db.Decimal(5, 2)
  status           StatusPinjaman    @default(DIAJUKAN)
  tanggalAjuan     DateTime          @default(now())
  tanggalCair      DateTime?
  sisaPokok        Decimal?          @db.Decimal(18, 2)
  catatan          String?
  alasanPenolakan  String?
  angsuran         Angsuran[]
  dokumen          DokumenPinjaman[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([anggotaId])
  @@index([status])
}

model Angsuran {
  id           String    @id @default(uuid())
  pinjamanId   String
  pinjaman     Pinjaman  @relation(fields: [pinjamanId], references: [id], onDelete: Cascade)
  bulanKe      Int
  jatuhTempo   DateTime
  pokok        Decimal   @db.Decimal(18, 2)
  bunga        Decimal   @db.Decimal(18, 2)
  biayaAdmin   Decimal   @default(0) @db.Decimal(18, 2)
  total        Decimal   @db.Decimal(18, 2)
  dibayar      Boolean   @default(false)
  tanggalBayar DateTime?
  noInvoice    String?   @unique

  @@unique([pinjamanId, bulanKe])
  @@map("Angsuran")
}

model DokumenPinjaman {
  id         String   @id @default(uuid())
  pinjamanId String
  pinjaman   Pinjaman @relation(fields: [pinjamanId], references: [id], onDelete: Cascade)
  jenis      String
  filePath   String
  uploadedAt DateTime @default(now())
}

// ==========================================
// 6. PENDAPATAN & BIAYA OPERASIONAL
// ==========================================

enum JenisPendapatan {
  BUNGA_PINJAMAN
  ADMINISTRASI_RISIKO
  JASA_LAINNYA
  LABA_TOKO_POS
  JASA_TITIP_GADAI
}

model Pendapatan {
  id          String          @id @default(uuid())
  satminkalId String?
  satminkal   Satminkal?      @relation(fields: [satminkalId], references: [id])
  tahun       Int
  jenis       JenisPendapatan
  nominal     Decimal         @db.Decimal(18, 2)
  keterangan  String?
  createdAt   DateTime        @default(now())

  @@index([tahun])
}

enum JenisBiayaOperasional {
  HONOR_PENGURUS
  OPERASIONAL_KANTOR
  RAPAT_PENDIDIKAN_SOSIAL
  LAINNYA
}

model BiayaOperasional {
  id          String                @id @default(uuid())
  satminkalId String?
  satminkal   Satminkal?            @relation(fields: [satminkalId], references: [id])
  tahun       Int
  jenis       JenisBiayaOperasional
  nominal     Decimal               @db.Decimal(18, 2)
  keterangan  String?
  tanggal     DateTime              @default(now())
  createdAt   DateTime              @default(now())

  @@index([satminkalId])
  @@index([tahun])
}

// ==========================================
// 7. SHU (Sisa Hasil Usaha)
// ==========================================

model PeriodeShu {
  id               String       @id @default(uuid())
  tahun            Int          @unique
  totalPendapatan  Decimal      @db.Decimal(18, 2)
  totalBeban       Decimal      @db.Decimal(18, 2)
  shuBersih        Decimal      @db.Decimal(18, 2)
  cadangan         Decimal      @db.Decimal(18, 2)
  jasaModal        Decimal      @db.Decimal(18, 2)
  jasaUsaha        Decimal      @db.Decimal(18, 2)
  pengurus         Decimal      @db.Decimal(18, 2)
  sosialPendidikan Decimal      @db.Decimal(18, 2)
  ditutup          Boolean      @default(false)
  ditutupPada      DateTime?
  shuAnggota       ShuAnggota[]
  createdAt        DateTime     @default(now())
}

model ShuAnggota {
  id           String     @id @default(uuid())
  periodeShuId String
  periodeShu   PeriodeShu @relation(fields: [periodeShuId], references: [id], onDelete: Cascade)
  anggotaId    String
  anggota      Anggota    @relation(fields: [anggotaId], references: [id])
  jasaModal    Decimal    @db.Decimal(18, 2)
  jasaUsaha    Decimal    @db.Decimal(18, 2)
  total        Decimal    @db.Decimal(18, 2)

  @@unique([periodeShuId, anggotaId])
}

// ==========================================
// 8. MASTER KOPSTUK & TAJUK TANDA TANGAN
// ==========================================

model Kopstuk {
  id           String     @id @default(uuid())
  satminkalId  String?    @unique
  satminkal    Satminkal? @relation(fields: [satminkalId], references: [id])
  kotamaId     String?
  kotama       Kotama?    @relation(fields: [kotamaId], references: [id])
  namaSatuan   String // Contoh: MARKAS BESAR ANGKATAN DARAT
  namaBalak    String // Contoh: DINAS INFORMASI DAN PENGOLAHAN DATA
  alamat       String?
  nomorTelepon String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([kotamaId])
  @@map("tb_kopstuk")
}

model TajukTandaTangan {
  id          String     @id @default(uuid())
  satminkalId String?
  satminkal   Satminkal? @relation(fields: [satminkalId], references: [id])
  kotamaId    String?
  kotama      Kotama?    @relation(fields: [kotamaId], references: [id])
  jabatan     String // Contoh: Kasubdistekinfo Selaku Kalakgiat / Kaprimkopad
  namaPejabat String // Contoh: Sigit Suhendro Hadi K., S.T., M.Tr.(Han)
  pangkat     String // Contoh: Kolonel Inf
  nrp         String // Contoh: 11020019460278
  isAktif     Boolean    @default(true)
  kategori    String? // Contoh: LAPORAN_SHU, KWITANSI, AKAD_KREDIT
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([satminkalId])
  @@index([kotamaId])
  @@map("tb_tajuk_ttd")
}

// ==========================================
// 9. PENGATURAN KOPERASI & SUKU BUNGA
// ==========================================

model PengaturanKoperasi {
  id                       String    @id @default(uuid())
  satminkalId              String    @unique
  satminkal                Satminkal @relation(fields: [satminkalId], references: [id], onDelete: Cascade)
  bungaPinjamanPersenTahun Decimal   @default(12) @db.Decimal(5, 2)
  nominalSimpananPokok     Decimal   @default(50000) @db.Decimal(18, 2)
  nominalSimpananWajib     Decimal   @default(100000) @db.Decimal(18, 2)
  nominalSimpananKhusus    Decimal   @default(0) @db.Decimal(18, 2)
  updatedAt                DateTime  @updatedAt
  createdAt                DateTime  @default(now())

  @@map("tb_pengaturan_koperasi")
}

model RiwayatBunga {
  id               String    @id @default(uuid())
  satminkalId      String
  bungaPersenTahun Decimal   @db.Decimal(5, 2)
  keterangan       String?
  diubahOlehId     String?
  createdAt        DateTime  @default(now())

  @@index([satminkalId])
  @@map("tb_riwayat_bunga")
}

// ==========================================
// 10. MODUL INVENTORI, TOKO & MULTI-SATUAN
// ==========================================

model KategoriProduk {
  id          String    @id @default(uuid())
  satminkalId String
  satminkal   Satminkal @relation(fields: [satminkalId], references: [id])
  nama        String
  deskripsi   String?
  produk      Produk[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tb_kategori_produk")
}

enum JenisSumberProduk {
  INVENTORI_KOPERASI
  MARKETPLACE_ANGGOTA
}

model Produk {
  id               String              @id @default(uuid())
  satminkalId      String
  satminkal        Satminkal           @relation(fields: [satminkalId], references: [id])
  kategoriId       String?
  kategori         KategoriProduk?     @relation(fields: [kategoriId], references: [id])
  kodeBarcode      String              @unique
  namaProduk       String
  satuanKecil      String              @default("Pcs")
  satuanBesar      String?
  pcsPerUnit       Int                 @default(1)
  hargaBeli        Decimal             @db.Decimal(18, 2)
  hargaJual        Decimal             @db.Decimal(18, 2)
  stokFisik        Int                 @default(0)
  stokMinimum      Int                 @default(5)
  diskonPersen     Decimal             @default(0) @db.Decimal(5, 2)
  isPromoAktif     Boolean             @default(false)
  isFastConsume    Boolean             @default(false)
  sumberProduk     JenisSumberProduk   @default(INVENTORI_KOPERASI)
  penjualAnggotaId String?
  gambarUrl        String?
  isAktif          Boolean             @default(true)
  mutasiStok       MutasiStok[]
  itemTransaksi    ItemTransaksiPos[]
  itemPembelian    ItemPembelian[]
  itemRetur        ItemReturSupplier[]
  itemPesanan      ItemPesananOnline[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([satminkalId])
  @@index([kodeBarcode])
  @@map("tb_produk")
}

// ==========================================
// 11. PENGADAAN & SUPPLIER
// ==========================================

model Supplier {
  id            String              @id @default(uuid())
  satminkalId   String
  satminkal     Satminkal           @relation(fields: [satminkalId], references: [id])
  kodeSupplier  String              @unique
  namaSupplier  String
  kontakPerson  String?
  telepon       String?
  alamat        String?
  totalHutang   Decimal             @default(0) @db.Decimal(18, 2)
  pembelian     PembelianSupplier[]
  returSupplier ReturSupplier[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("tb_supplier")
}

model PembelianSupplier {
  id             String                @id @default(uuid())
  satminkalId    String
  satminkal      Satminkal             @relation(fields: [satminkalId], references: [id])
  supplierId     String
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  nomorNota      String                @unique
  tanggalNota    DateTime              @default(now())
  metodeBayar    String                @default("TUNAI")
  jatuhTempo     DateTime?
  totalPembelian Decimal               @db.Decimal(18, 2)
  sisaHutang     Decimal               @default(0) @db.Decimal(18, 2)
  statusLunas    Boolean               @default(true)
  items          ItemPembelian[]
  retur          ReturSupplier[]
  pembayaran     BayarHutangSupplier[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("tb_pembelian_supplier")
}

model ItemPembelian {
  id                String            @id @default(uuid())
  pembelianId       String
  pembelian         PembelianSupplier @relation(fields: [pembelianId], references: [id], onDelete: Cascade)
  produkId          String
  produk            Produk            @relation(fields: [produkId], references: [id])
  jumlahSatuanBesar Int               @default(0)
  satuanBesar       String?
  isiPerSatuan      Int               @default(1)
  totalJumlahPcs    Int
  hargaBeliSatuan   Decimal           @db.Decimal(18, 2)
  subtotal          Decimal           @db.Decimal(18, 2)

  @@map("tb_item_pembelian")
}

model ReturSupplier {
  id              String              @id @default(uuid())
  satminkalId     String
  satminkal       Satminkal           @relation(fields: [satminkalId], references: [id])
  pembelianId     String
  pembelian       PembelianSupplier   @relation(fields: [pembelianId], references: [id])
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  nomorRetur      String              @unique
  tanggalRetur    DateTime            @default(now())
  totalNilaiRetur Decimal             @db.Decimal(18, 2)
  alasanRetur     String?
  items           ItemReturSupplier[]
  createdAt       DateTime            @default(now())

  @@map("tb_retur_supplier")
}

model ItemReturSupplier {
  id          String        @id @default(uuid())
  returId     String
  retur       ReturSupplier @relation(fields: [returId], references: [id], onDelete: Cascade)
  produkId    String
  produk      Produk        @relation(fields: [produkId], references: [id])
  jumlahPcs   Int
  hargaSatuan Decimal       @db.Decimal(18, 2)
  subtotal    Decimal       @db.Decimal(18, 2)

  @@map("tb_item_retur_supplier")
}

model BayarHutangSupplier {
  id           String            @id @default(uuid())
  pembelianId  String
  pembelian    PembelianSupplier @relation(fields: [pembelianId], references: [id])
  tanggalBayar DateTime          @default(now())
  nominalBayar Decimal           @db.Decimal(18, 2)
  noKwitansi   String?
  keterangan   String?
  createdAt    DateTime          @default(now())

  @@map("tb_bayar_hutang_supplier")
}

// ==========================================
// 12. POS KASIR & MUTASI STOK
// ==========================================

enum MetodeBayarPos {
  TUNAI
  QRIS
  TRANSFER
  KREDIT_TEMPO
}

model TransaksiPos {
  id            String             @id @default(uuid())
  satminkalId   String
  satminkal     Satminkal          @relation(fields: [satminkalId], references: [id])
  nomorInvoice  String             @unique
  kasirId       String
  kasir         User               @relation("KasirTransaksi", fields: [kasirId], references: [id])
  anggotaId     String?
  anggota       Anggota?           @relation(fields: [anggotaId], references: [id])
  namaPelanggan String?
  metodeBayar   MetodeBayarPos     @default(TUNAI)
  totalItem     Int
  totalBelanja  Decimal            @db.Decimal(18, 2)
  totalHpp      Decimal            @db.Decimal(18, 2)
  totalDiskon   Decimal            @default(0) @db.Decimal(18, 2)
  bayarTunai    Decimal            @default(0) @db.Decimal(18, 2)
  kembalian     Decimal            @default(0) @db.Decimal(18, 2)
  poinDidapat   Int                @default(0)
  status        String             @default("SELESAI")
  pinjamanId    String?
  items         ItemTransaksiPos[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("tb_transaksi_pos")
}

model ItemTransaksiPos {
  id           String       @id @default(uuid())
  transaksiId  String
  transaksi    TransaksiPos @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  produkId     String
  produk       Produk       @relation(fields: [produkId], references: [id])
  jumlah       Int
  hargaBeliHpp Decimal      @db.Decimal(18, 2)
  hargaJual    Decimal      @db.Decimal(18, 2)
  diskonItem   Decimal      @default(0) @db.Decimal(18, 2)
  subtotal     Decimal      @db.Decimal(18, 2)

  @@map("tb_item_transaksi_pos")
}

model MutasiStok {
  id            String   @id @default(uuid())
  produkId      String
  produk        Produk   @relation(fields: [produkId], references: [id])
  jenis         String
  jumlahPcs     Int
  stokSebelum   Int
  stokSesudah   Int
  referensiNota String?
  keterangan    String?
  createdAt     DateTime @default(now())

  @@map("tb_mutasi_stok")
}

// ==========================================
// 13. PESANAN ONLINE, TITIP PIKET & DELIVERY CEPAT DENGAN SLA
// ==========================================

enum TipePengambilan {
  AMBIL_SENDIRI
  TITIP_PIKET_SATUAN
  DELIVERY_CEPAT
}

enum StatusPesananOnline {
  MENUNGGU_KONFIRMASI
  DIPROSES_PETUGAS
  SEDANG_DIANTAR
  TITIP_DI_PIKET
  SELESAI
  DIBATALKAN
}

model PesananOnline {
  id               String              @id @default(uuid())
  satminkalId      String
  satminkal        Satminkal           @relation(fields: [satminkalId], references: [id])
  nomorPesanan     String              @unique
  anggotaId        String
  anggota          Anggota             @relation(fields: [anggotaId], references: [id])
  tipePengambilan  TipePengambilan     @default(AMBIL_SENDIRI)
  lokasiTujuan     String?
  namaPetugasPiket String?
  noHpPenerima     String?
  ongkir           Decimal             @default(0) @db.Decimal(18, 2)
  totalHargaBarang Decimal             @db.Decimal(18, 2)
  totalTagihan     Decimal             @db.Decimal(18, 2)
  metodeBayar      MetodeBayarPos      @default(TUNAI)
  status           StatusPesananOnline @default(MENUNGGU_KONFIRMASI)
  estimasiMenit    Int                 @default(30)
  waktuPesan       DateTime            @default(now())
  waktuMulaiAntar  DateTime?
  waktuSelesai     DateTime?
  isTerlambatSla   Boolean             @default(false)
  kompensasiDiskon Decimal             @default(0) @db.Decimal(18, 2)
  items            ItemPesananOnline[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@map("tb_pesanan_online")
}

model ItemPesananOnline {
  id          String        @id @default(uuid())
  pesananId   String
  pesanan     PesananOnline @relation(fields: [pesananId], references: [id], onDelete: Cascade)
  produkId    String
  produk      Produk        @relation(fields: [produkId], references: [id])
  jumlah      Int
  hargaSatuan Decimal       @db.Decimal(18, 2)
  subtotal    Decimal       @db.Decimal(18, 2)

  @@map("tb_item_pesanan_online")
}

// ==========================================
// 14. MARKETPLACE UMKM ANGGOTA (PENGAJUAN & VALIDASI)
// ==========================================

enum StatusPengajuanMarketplace {
  DIAJUKAN
  DISETUJUI
  DITOLAK
  NONAKTIF
}

model PengajuanMarketplace {
  id             String                     @id @default(uuid())
  satminkalId    String
  satminkal      Satminkal                  @relation(fields: [satminkalId], references: [id])
  anggotaId      String
  anggota        Anggota                    @relation(fields: [anggotaId], references: [id])
  namaProduk     String
  kategori       String
  deskripsi      String?
  hargaJualUsul  Decimal                    @db.Decimal(18, 2)
  komisiKoperasi Decimal                    @default(5) @db.Decimal(5, 2)
  stokAwal       Int                        @default(1)
  gambarUrl      String?
  status         StatusPengajuanMarketplace @default(DIAJUKAN)
  catatanReview  String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@map("tb_pengajuan_marketplace")
}

// ==========================================
// 15. UNIT USAHA GADAI & LELANG BARANG SITA
// ==========================================

enum KategoriBarangGadai {
  EMAS_PERHIASAN
  ELEKTRONIK_GADGET
  KENDARAAN_BERMOTOR
  LAINNYA
}

enum StatusGadai {
  PENGAJUAN_TAKSIRAN
  AKTIF_BERJALAN
  DITEBUS_LUNAS
  JATUH_TEMPO_LELANG
  BARANG_TERJUAL_LELANG
}

model GadaiBarang {
  id                 String              @id @default(uuid())
  satminkalId        String
  satminkal          Satminkal           @relation(fields: [satminkalId], references: [id])
  nomorSbg           String              @unique
  anggotaId          String
  anggota            Anggota             @relation(fields: [anggotaId], references: [id])
  kategori           KategoriBarangGadai
  namaBarang         String
  spesifikasiKondisi String?
  nilaiTaksiran      Decimal             @db.Decimal(18, 2)
  uangPinjamanGadai  Decimal             @db.Decimal(18, 2)
  biayaJasaTitip     Decimal             @default(1.5) @db.Decimal(5, 2)
  biayaAdmin         Decimal             @default(25000) @db.Decimal(18, 2)
  tanggalGadai       DateTime            @default(now())
  jatuhTempo         DateTime
  status             StatusGadai         @default(AKTIF_BERJALAN)
  tanggalPenebusan   DateTime?
  totalDitebus       Decimal?            @db.Decimal(18, 2)
  fotoBarangUrl      String?
  hargaLelangBuka    Decimal?            @db.Decimal(18, 2)
  hargaLelangTerjual Decimal?           @db.Decimal(18, 2)
  tanggalTerjual     DateTime?
  pembeliLelang      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("tb_gadai_barang")
}

// ==========================================
// 16. LOYALTY POINT, UNDIAN RAT & TARGET BUYING
// ==========================================

model PoinAnggota {
  id             String   @id @default(uuid())
  anggotaId      String   @unique
  anggota        Anggota  @relation(fields: [anggotaId], references: [id])
  totalPoinAktif Int      @default(0)
  totalPoinKlaim Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@map("tb_poin_anggota")
}

model EventUndian {
  id           String        @id @default(uuid())
  satminkalId  String
  satminkal    Satminkal     @relation(fields: [satminkalId], references: [id])
  namaEvent    String
  poinPerKupon Int           @default(50)
  hadiahUtama  String
  tanggalUndi  DateTime
  isSelesai    Boolean       @default(false)
  kupon        KuponUndian[]
  createdAt    DateTime      @default(now())

  @@map("tb_event_undian")
}

model KuponUndian {
  id         String      @id @default(uuid())
  eventId    String
  event      EventUndian @relation(fields: [eventId], references: [id], onDelete: Cascade)
  anggotaId  String
  anggota    Anggota     @relation(fields: [anggotaId], references: [id])
  nomorKupon String      @unique
  isPemenang Boolean     @default(false)
  namaHadiah String?
  createdAt  DateTime    @default(now())

  @@map("tb_kupon_undian")
}

model TargetBelanjaBulanan {
  id            String    @id @default(uuid())
  satminkalId   String
  satminkal     Satminkal @relation(fields: [satminkalId], references: [id])
  bulanTahun    String
  targetNominal Decimal   @default(500000) @db.Decimal(18, 2)
  bonusPoin     Int       @default(100)
  createdAt     DateTime  @default(now())

  @@unique([satminkalId, bulanTahun])
  @@map("tb_target_belanja_bulanan")
}

// ==========================================
// 17. AUDIT LOG & MONITORING AKTIVITAS
// ==========================================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  username    String?
  role        String?
  action      String   // LOGIN, LOGOUT, MONITORING_START, MONITORING_END, CREATE_SATMINKAL, UPDATE_SATMINKAL, CREATE_ADMIN, UPDATE_ADMIN, CRUD_DATA
  targetType  String?  // SATMINKAL, ANGGOTA, USER, DOKUMEN, PINJAMAN, SIMPANAN
  targetId    String?
  kotamaId    String?
  satminkalId String?
  details     Json?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([kotamaId])
  @@index([satminkalId])
  @@index([timestamp])
  @@map("tb_audit_log")
}


